{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Immutable conversational owner evidence",
  "type":"object",
  "required":["format"],
  "properties":{"format":{"enum":["crux.owner-decision-presentation.v1","crux.owner-decision-capture.v1","crux.owner-decision-application.v1"]}},
  "if":{"properties":{"format":{"const":"crux.owner-decision-presentation.v1"}}},
  "then":{
    "type":"object","additionalProperties":false,
    "required":["format","op_id","purpose","cycle_id","subject","subject_sha256","question","at","record_sha256"],
    "properties":{
      "format":{"const":"crux.owner-decision-presentation.v1"},
      "op_id":{"type":"string","pattern":"^[A-Za-z0-9._-]{8,64}$"},
      "purpose":{"enum":["idr","adr-acceptance","acceptance-change"]},"cycle_id":{"type":["string","null"]},
      "subject":{"type":"string","minLength":1},"subject_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
      "question":{"type":"string","minLength":1},"at":{"type":"string","minLength":1},
      "record_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
    }
  },
  "else":{
    "if":{"properties":{"format":{"const":"crux.owner-decision-capture.v1"}}},
    "then":{
      "type":"object","additionalProperties":false,
      "required":["format","op_id","purpose","cycle_id","subject","subject_sha256","presentation","disposition","quote","source","owner_date","supersedes","at","record_sha256"],
      "properties":{
        "format":{"const":"crux.owner-decision-capture.v1"},
        "op_id":{"type":"string","pattern":"^[A-Za-z0-9._-]{8,64}$"},
        "purpose":{"enum":["idr","adr-acceptance","acceptance-change"]},"cycle_id":{"type":["string","null"]},
        "subject":{"type":"string","minLength":1},"subject_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "presentation":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
        "disposition":{"enum":["approve","reject","pending"]},"quote":{"type":"string","minLength":1},
        "source":{"type":"object","additionalProperties":false,"required":["kind","reference"],"properties":{"kind":{"enum":["conversation","tool-question"]},"reference":{"type":"string","minLength":1}}},
        "owner_date":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "supersedes":{"type":["object","null"],"if":{"type":"object"},"then":{"additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}},
        "at":{"type":"string","minLength":1},"record_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
      }
    },
    "else":{
      "type":"object","additionalProperties":false,
      "required":["format","purpose","cycle_id","subject","subject_sha256","capture","applied_at","record_sha256"],
      "properties":{
        "format":{"const":"crux.owner-decision-application.v1"},
        "purpose":{"enum":["idr","adr-acceptance","acceptance-change"]},"cycle_id":{"type":["string","null"]},
        "subject":{"type":"string","minLength":1},"subject_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "capture":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
        "applied_at":{"type":"string","minLength":1},"record_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
      }
    }
  }
}
