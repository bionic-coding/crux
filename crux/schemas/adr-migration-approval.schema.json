{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "at": {
      "minLength": 1,
      "type": "string"
    },
    "council": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "format": {
      "const": "crux.adr-migration-approval.v1"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "owner": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "minLength": 1,
          "type": "string"
        },
        "at": {
          "minLength": 1,
          "type": "string"
        },
        "conversation": {
          "minLength": 1,
          "type": "string"
        },
        "origin": {
          "const": "owner-conversation"
        },
        "owner_exception": {
          "additionalProperties": false,
          "properties": {
            "path": {
              "minLength": 1,
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "type": "object"
        },
        "presented": {
          "additionalProperties": false,
          "properties": {
            "path": {
              "minLength": 1,
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "type": "object"
        },
        "quote": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "origin",
        "quote",
        "action",
        "at",
        "conversation",
        "presented"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "owner_exception": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "package": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "policy": {
      "enum": [
        "council-and-human",
        "council-only"
      ]
    },
    "policy_basis": {
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
      "type": "string"
    },
    "readiness": {
      "else": {
        "additionalProperties": false,
        "properties": {
          "commit": {
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
            "type": "string"
          },
          "review": {
            "additionalProperties": false,
            "properties": {
              "path": {
                "minLength": 1,
                "type": "string"
              },
              "sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "type": "object"
          },
          "sources": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "path": {
                  "minLength": 1,
                  "type": "string"
                },
                "sha256": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "tests": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "path": {
                  "minLength": 1,
                  "type": "string"
                },
                "sha256": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "commit",
          "sources",
          "tests",
          "review"
        ],
        "type": "object"
      },
      "if": {
        "required": [
          "format"
        ]
      },
      "then": {
        "additionalProperties": false,
        "properties": {
          "format": {
            "const": "crux.adr-migration-installed-support.v1"
          },
          "sources": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "path": {
                  "minLength": 1,
                  "type": "string"
                },
                "sha256": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "format",
          "sources"
        ],
        "type": "object"
      },
      "type": "object"
    },
    "review_bundle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "format",
    "id",
    "package",
    "council",
    "readiness",
    "policy",
    "policy_basis",
    "owner",
    "at",
    "review_bundle_sha256"
  ],
  "title": "Prospective ADR migration approval",
  "type": "object"
}
