{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cycle record",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "id", "revision", "state", "title", "lead", "base_commit", "created_at", "updated_at", "plan", "tasks", "checks", "councils", "review", "delivery", "blockers", "history", "completion"],
  "properties": {
    "format": {"enum": ["crux.cycle.vNext", "crux.cycle.v1"]},
    "kind": {"enum": ["release"]},
    "release": {
      "type": "object", "additionalProperties": false, "required": ["list", "version"],
      "properties": {"list": {"enum": ["beta", "official"]}, "version": {"type": "string", "minLength": 1}}
    },
    "adrs": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["adr", "path", "sha256"],
      "properties": {
        "adr": {"type": "string", "pattern": "^(?:[A-Z][A-Z0-9]{1,9}-)?ADR-[0-9]{4,}$"}, "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }},
    "id": {"type": "string", "pattern": "^(?:[A-Z][A-Z0-9]{1,9}-)?CYC-[0-9]{4,}$"},
    "revision": {"type": "integer", "minimum": 1},
    "state": {"enum": ["planning", "working", "reviewing", "reviewed", "completed", "paused", "abandoned"]},
    "resume_state": {"enum": ["planning", "working", "reviewing", "reviewed"]},
    "title": {"type": "string", "minLength": 1},
    "lead": {"type": "string", "minLength": 1},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "goal", "scope", "acceptance"],
      "properties": {
        "revision": {"type": "integer", "minimum": 1},
        "goal": {"type": "string", "minLength": 1},
        "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "verification": {
          "type": "object", "additionalProperties": false, "required": ["checks", "gaps"],
          "properties": {
            "checks": {"type": "array", "minItems": 1, "items": {
              "type": "object", "additionalProperties": false, "required": ["id", "rationale"],
              "properties": {"id": {"type": "string", "minLength": 1}, "rationale": {"type": "string", "minLength": 1}}
            }},
            "gaps": {"type": "string", "minLength": 1}
          }
        },
        "scrutiny": {
          "type": "object", "additionalProperties": false, "required": ["level", "reason"],
          "properties": {"level": {"enum": ["focused", "standard", "intensive"]}, "reason": {"type": "string", "minLength": 1}}
        },
        "council": {
          "type": "object", "additionalProperties": false, "required": ["needed", "reason"],
          "properties": {
            "needed": {"type": "boolean"}, "reason": {"type": "string", "minLength": 1},
            "approach": {"type": "string", "minLength": 1},
            "questions": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "tasks": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "description", "owner", "run", "status", "kind", "depends_on", "council", "checkout", "summary", "attempts"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1}, "run": {"type": "integer", "minimum": 0},
        "status": {"enum": ["pending", "working", "blocked", "done"]},
        "kind": {"enum": ["implementation", "review"]},
        "depends_on": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "council": {"type": "boolean"}, "checkout": {"type": ["string", "null"]},
        "adr_dependencies": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^ADR-[0-9]{4,}$"}},
        "summary": {"type": "string"},
        "attempts": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["run", "owner", "checkout", "started_at", "ended_at", "outcome", "summary"],
          "properties": {
            "run": {"type": "integer", "minimum": 1}, "owner": {"type": "string", "minLength": 1},
            "checkout": {"type": ["string", "null"]}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
            "started_at": {"type": "string", "minLength": 1},
            "ended_at": {"type": ["string", "null"]}, "outcome": {"enum": [null, "done", "blocked", "interrupted"]},
            "summary": {"type": "string"}
          }
        }}
      }
    }},
    "checks": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "at", "check_id", "plan_revision", "command", "tested_revision", "result", "summary", "reason", "use"],
      "properties": {
        "id": {"type": "string", "pattern": "^LC-[0-9a-f]{32}$"}, "at": {"type": "string", "minLength": 1},
        "check_id": {"type": "string", "minLength": 1}, "plan_revision": {"type": "integer", "minimum": 1},
        "command": {"type": "string", "minLength": 1}, "tested_revision": {"type": "string", "minLength": 1},
        "result": {"enum": ["passed", "failed"]}, "summary": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}, "use": {"enum": ["executed", "reused"]},
        "reused_from": {"type": "string", "pattern": "^LC-[0-9a-f]{32}$"}
      }
    }},
    "councils": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["plan_revision", "subject", "record", "outcome", "response", "at"],
      "properties": {
        "plan_revision": {"type": "integer", "minimum": 1}, "subject": {"type": "string", "minLength": 1},
        "record": {"type": "string", "minLength": 1}, "outcome": {"enum": ["approved"]},
        "response": {"type": "string", "minLength": 1}, "at": {"type": "string", "minLength": 1}
      }
    }},
    "review": {"type": ["object", "null"]},
    "follows": {"type": "string", "pattern": "^(?:[A-Z][A-Z0-9]{1,9}-)?CYC-[0-9]{4,}$"},
    "review_request": {
      "type": "object", "additionalProperties": false, "required": ["reviewer", "plan_revision", "head_commit", "at"],
      "properties": {
        "reviewer": {"type": "string", "minLength": 1}, "plan_revision": {"type": "integer", "minimum": 1},
        "head_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}, "at": {"type": "string", "minLength": 1}
      }
    },
    "queue": {
      "type": "object", "additionalProperties": false,
      "required": ["item", "token"],
      "properties": {
        "item": {"type": "string", "pattern": "^Q-[0-9]{4,}$"}, "token": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "origin": {"enum": ["start", "reconcile"]}, "started_at": {"type": "string", "minLength": 1},
        "item_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "review_head": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "assessment": {
          "type": "object", "additionalProperties": false, "required": ["outcome", "acceptance"],
          "properties": {
            "outcome": {"type": "string", "minLength": 1},
            "acceptance": {"type": "array", "items": {
              "type": "object", "additionalProperties": false, "required": ["criterion", "evidence"],
              "properties": {"criterion": {"type": "integer", "minimum": 0}, "evidence": {"type": "string", "minLength": 1}}
            }}
          }
        },
        "reconciled_at": {"type": "string", "minLength": 1}
      }
    },
    "delivery": {
      "type": "object", "additionalProperties": false, "required": ["pr", "ci", "merge", "commit"],
      "properties": {
        "pr": {"type": ["string", "null"]}, "ci": {"enum": ["unknown", "pending", "passed", "failed"]},
        "merge": {"enum": ["unmerged", "merged"]}, "commit": {"type": ["string", "null"]},
        "published": {"type": ["string", "null"]}
      }
    },
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "history": {"type": "array", "items": {"type": "object"}},
    "completion": {"type": ["object", "null"]}
  }
}
