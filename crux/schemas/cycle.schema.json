{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Crux single-undertaking cycle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "type",
    "goal",
    "status",
    "phase",
    "pass",
    "pass_limit",
    "created_at",
    "updated_at",
    "implementers",
    "coordinator",
    "plan",
    "review_policy",
    "required_checks",
    "evidence",
    "decisions",
    "reviews",
    "history",
    "reflection",
    "blocker",
    "extensions",
    "release"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^(?:[A-Z][A-Z0-9]{1,9}-)?CYC-[0-9]{4,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "dev",
        "iterate",
        "refactor",
        "simplify",
        "quick-fix",
        "release"
      ]
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "active",
        "paused",
        "completed",
        "abandoned"
      ]
    },
    "phase": {
      "enum": [
        "plan",
        "build",
        "test",
        "verify",
        "review",
        "release",
        "reflect"
      ]
    },
    "pass": {
      "type": "integer",
      "minimum": 1
    },
    "pass_limit": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "implementers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "coordinator": {
      "type": "string",
      "minLength": 1
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "scope",
        "constraints",
        "acceptance",
        "verification",
        "tasks"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "streams": {
          "type": "array",
          "description": "Optional declared implementation streams. Absence records no stream facts.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "paths", "independent"],
            "properties": {
              "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
              "paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "independent": {"type": "boolean"}
            }
          }
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verification": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "phase",
              "description",
              "depends_on",
              "status",
              "expected_evidence"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "phase": {
                "enum": [
                  "plan",
                  "build",
                  "test",
                  "verify",
                  "review",
                  "release",
                  "reflect"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "depends_on": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "integrates": {
                "type": "array",
                "minItems": 2,
                "description": "Build task IDs this Build unit integrates; each must also be a dependency.",
                "items": {"type": "string", "minLength": 1}
              },
              "status": {
                "enum": [
                  "pending",
                  "active",
                  "done",
                  "blocked"
                ]
              },
              "expected_evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "assignee": {
                "type": "string",
                "minLength": 1
              },
              "result_path": {
                "type": "string",
                "minLength": 1
              },
              "commits": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                }
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "stage": {
                "enum": [
                  "implemented",
                  "integrated"
                ]
              },
              "note": {
                "type": "string",
                "minLength": 1
              },
              "replaced_commits": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "from",
                    "to",
                    "at",
                    "note"
                  ],
                  "properties": {
                    "from": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40}$"
                    },
                    "to": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40}$"
                    },
                    "at": {
                      "type": "string",
                      "minLength": 1
                    },
                    "note": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "adopted_commits": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["sha", "source_task", "pass", "attempt"],
                  "properties": {
                    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                    "source_task": {"type": "string", "minLength": 1},
                    "pass": {"type": "integer", "minimum": 1},
                    "attempt": {"type": ["integer", "null"], "minimum": 1}
                  }
                }
              },
              "fix": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "finding",
                  "eligibility",
                  "pass"
                ],
                "properties": {
                  "finding": {
                    "type": "string",
                    "minLength": 1
                  },
                  "eligibility": {
                    "type": "string",
                    "minLength": 1
                  },
                  "findings": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "pattern": "^r[0-9]+:blocking:[0-9]+$"
                    }
                  },
                  "pass": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "criterion": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["index", "before"],
                    "properties": {
                      "index": {"type": "integer", "minimum": 0},
                      "before": {
                        "type": "object", "additionalProperties": false,
                        "required": ["path", "sha256"],
                        "properties": {
                          "path": {"type": "string", "minLength": 1},
                          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                        }
                      },
                      "after": {
                        "type": "object", "additionalProperties": false,
                        "required": ["path", "sha256"],
                        "properties": {
                          "path": {"type": "string", "minLength": 1},
                          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                        }
                      }
                    }
                  },
                  "before": {
                    "type": "string",
                    "pattern": "^TE-[0-9a-f]{32}$"
                  },
                  "after": {
                    "type": "string",
                    "pattern": "^TE-[0-9a-f]{32}$"
                  },
                  "review": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "sha256"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sha256": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "preserved_behavior": {
          "type": "string",
          "minLength": 1
        },
        "improvement": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "review_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scrutiny",
        "rationale",
        "risks"
      ],
      "properties": {
        "scrutiny": {
          "enum": [
            "focused",
            "standard",
            "intensive"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "required_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "build_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "evidence_id",
          "pass",
          "use"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "pass": {
            "type": "integer",
            "minimum": 1
          },
          "use": {
            "enum": [
              "executed",
              "reused",
              "waited"
            ]
          },
          "declaration_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "kind",
          "name",
          "approval",
          "accepted"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "enum": [
              "idr",
              "adr"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "approval": {
            "type": [
              "string",
              "null"
            ]
          },
          "accepted": {
            "type": "boolean"
          }
        }
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "at",
          "action",
          "pass",
          "phase"
        ],
        "properties": {
          "at": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "pass": {
            "type": "integer",
            "minimum": 1
          },
          "phase": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "active",
              "paused",
              "completed",
              "abandoned"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "reflection": {
      "type": [
        "object",
        "null"
      ]
    },
    "blocker": {
      "type": [
        "object",
        "null"
      ]
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "release": {
      "type": [
        "object",
        "null"
      ]
    },
    "phase_names": {
      "enum": [
        "verify"
      ]
    },
    "release_list": {
      "enum": [
        "beta",
        "official"
      ]
    },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "task",
          "agent",
          "result_path",
          "state",
          "attempt",
          "started_at",
          "last_seen",
          "ended_at",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "task": {
            "type": [
              "string",
              "null"
            ]
          },
          "agent": {
            "type": [
              "string",
              "null"
            ]
          },
          "result_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "enum": [
              "reserved",
              "running",
              "finished",
              "lost"
            ]
          },
          "attempt": {
            "type": "integer",
            "minimum": 1
          },
          "started_at": {
            "type": "string",
            "minLength": 1
          },
          "last_seen": {
            "type": "string",
            "minLength": 1
          },
          "ended_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "host": {
            "type": [
              "string",
              "null"
            ]
          },
          "mode": {
            "type": [
              "string",
              "null"
            ]
          },
          "base": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{40}$"
          },
          "delivery_token": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
          "execution": {
            "type": "object", "additionalProperties": false,
            "required": ["review_base", "execution_head", "checkout", "proof"],
            "properties": {
              "review_base": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              "execution_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              "checkout": {"type": "string", "minLength": 1},
              "proof": {
                "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
                "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
              }
            }
          },
          "execution_history": {"type": "array", "items": {"type": "object"}},
          "execution_started": {
            "type": "object", "additionalProperties": false, "required": ["delivery_token", "checkout"],
            "properties": {
              "delivery_token": {"type": ["string", "null"], "pattern": "^[0-9a-f]{32}$"},
              "checkout": {"type": "string", "minLength": 1}
            }
          },
          "resume_seal": {
            "type": "object", "additionalProperties": false,
            "required": ["host", "agent", "checkout", "review_base", "previous_token", "proof"],
            "properties": {
              "host": {"type": "string", "minLength": 1},
              "agent": {"type": "string", "minLength": 1},
              "checkout": {"type": "string", "minLength": 1},
              "review_base": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              "previous_token": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
              "proof": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"],
                "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
            }
          },
          "release_continuation": {
            "type": "object", "additionalProperties": false,
            "required": ["format", "list", "version", "target", "steps", "owner", "descriptor", "commands", "capabilities", "role_sha256", "artifact"],
            "properties": {
              "format": {"const": 1}, "list": {"enum": ["beta", "official"]},
              "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
              "target": {"type": "string", "minLength": 1},
              "steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "owner": {"type": "string", "minLength": 1},
              "descriptor": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"],
                "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
              "commands": {"type": "object"}, "capabilities": {"type": "object"},
              "role_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "artifact": {"type": ["object", "null"]}
            }
          },
          "invocation_snapshot": {
            "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          },
          "invocation_history": {
            "type": "array", "items": {
              "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          },
          "previous_results": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["path", "sha256"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          },
          "delivery": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "outcome",
              "commits",
              "evidence",
              "stage",
              "note"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "outcome": {
                "enum": [
                  "done",
                  "blocked",
                  "failed"
                ]
              },
              "commits": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                }
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "stage": {
                "enum": [
                  "implemented",
                  "integrated",
                  null
                ]
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "stop": {
                "description": "The stop a blocked delivery named (an owner decision, an approval wait, a contradicted premise, an outward act or an escalation loop). Absent on deliveries that named none and on records written before the field.",
                "enum": [
                  "owner-decision",
                  "approval-wait",
                  "contradicted-premise",
                  "outward-act",
                  "escalation-loop"
                ]
              }
            }
          }
        }
      }
    },
    "coverage": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "affected",
        "checks",
        "not_selected"
      ],
      "properties": {
        "affected": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check_id",
              "rationale"
            ],
            "properties": {
              "check_id": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "not_selected": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "completion": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "commits",
        "exception",
        "remaining",
        "input_sha256"
      ],
      "properties": {
        "commits": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
          }
        },
        "exception": {
          "type": [
            "string",
            "null"
          ]
        },
        "remaining": {
          "type": "string",
          "minLength": 1
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "test_runs": {
          "description": "Written by finish from the durable receipt store: executions are the receipts whose run started inside the cycle's window (creation to finish), each once and including failed and interrupted ones; reused are the receipts the record attaches that started outside it and add no minutes; minutes sum the executed wall seconds; with_retry_reason is the subtotal of executions started with a retry reason. A run killed before it wrote a receipt is not counted.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "executions",
            "with_retry_reason",
            "minutes",
            "executed",
            "reused",
            "unreadable"
          ],
          "properties": {
            "executions": {
              "type": "integer",
              "minimum": 0
            },
            "with_retry_reason": {
              "type": "integer",
              "minimum": 0
            },
            "minutes": {
              "type": "number",
              "minimum": 0
            },
            "executed": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "check_id",
                  "runs",
                  "receipts",
                  "with_retry_reason",
                  "minutes"
                ],
                "properties": {
                  "check_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "runs": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "receipts": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^TE-[0-9a-f]{32}$"
                    }
                  },
                  "with_retry_reason": {
                    "type": "integer",
                    "minimum": 0
                  },
