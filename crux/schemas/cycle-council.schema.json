{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prospective mode-aware council result",
  "type": "object",
  "required": [
    "format"
  ],
  "properties": {
    "format": {
      "enum": [
        "crux.cycle-council",
        "crux.cycle-council.v2"
      ]
    }
  },
  "if": {
    "properties": {
      "format": {
        "const": "crux.cycle-council.v2"
      }
    }
  },
  "then": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "format",
      "id",
      "purpose",
      "logical_id",
      "subject",
      "subject_sha256",
      "cycle_id",
      "at",
      "attempt",
      "policy",
      "outcome",
      "seats",
      "passes",
      "architect",
      "binding_failures",
      "reason",
      "record_sha256"
    ],
    "properties": {
      "format": {
        "const": "crux.cycle-council.v2"
      },
      "id": {
        "type": "string"
      },
      "purpose": {
        "enum": [
          "idr",
          "adr",
          "adr-creation",
          "consultation",
          "disposition"
        ]
      },
      "logical_id": {
        "type": "string"
      },
      "subject": {
        "type": "string"
      },
      "subject_sha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "cycle_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "at": {
        "type": "string"
      },
      "attempt": {
        "type": "string"
      },
      "policy": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode",
          "settings",
          "human_policy",
          "max_attempts",
          "policy_inputs",
          "initialization",
          "models"
        ],
        "properties": {
          "mode": {
            "enum": [
              "lite",
              "standard",
              "strict"
            ]
          },
          "settings": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "overrides",
              "max_attempts",
              "human_policy"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "lite",
                  "standard",
                  "strict"
                ]
              },
              "overrides": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "adr": {
                    "enum": [
                      "lite",
                      "standard",
                      "strict"
                    ]
                  },
                  "idr": {
                    "enum": [
                      "lite",
                      "standard",
                      "strict"
                    ]
                  },
                  "migration": {
                    "enum": [
                      "lite",
                      "standard",
                      "strict"
                    ]
                  }
                }
              },
              "max_attempts": {
                "type": "integer",
                "minimum": 1
              },
              "human_policy": {
                "enum": [
                  "council-and-human",
                  "council-only"
                ]
              }
            }
          },
          "human_policy": {
            "enum": [
              "council-and-human",
              "council-only"
            ]
          },
          "max_attempts": {
            "type": "integer",
            "minimum": 1
          },
          "policy_inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          "initialization": {
            "type": "boolean"
          },
          "models": {
            "type": "object"
          }
        }
      },
      "outcome": {
        "enum": [
          "approved",
          "changes-required",
          "could-not-run"
        ]
      },
      "seats": {
        "type": "array"
      },
      "passes": {
        "type": "array"
      },
      "architect": {
        "type": [
          "object",
          "null"
        ]
      },
      "binding_failures": {
        "type": "array"
      },
      "reason": {
        "type": [
          "string",
          "null"
        ]
      },
      "record_sha256": {
        "type": "string"
      },
      "readiness": {
        "type": "object"
      },
      "review_bundle_sha256": {
        "type": "string"
      }
    }
  }
}
